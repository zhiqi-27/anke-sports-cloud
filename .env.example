ANKE_SPORTS_ENV=local
ANKE_SPORTS_DATABASE_URL=sqlite:///./data/anke-sports.db
ANKE_SPORTS_PUBLIC_URL=http://localhost:8787
ANKE_SPORTS_WEB_URL=http://localhost:3000
ANKE_SPORTS_LOCAL_PREVIEW=true
# Independent Anke Sports Firebase project; never reuse another product's credentials.
ANKE_SPORTS_FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository.json
# Required outside local mode: URL-safe Fernet encryption key.
ANKE_SPORTS_ENCRYPTION_KEY=
BALLDONTLIE_API_KEY=
FOOTBALL_DATA_API_KEY=
YOUTUBE_API_KEY=
# Google project that owns the key; shared across all API/worker instances.
ANKE_SPORTS_YOUTUBE_PROJECT_ID=
# Local application cap, not actual Google quota. Resets at Pacific midnight.
ANKE_SPORTS_YOUTUBE_DAILY_BUDGET=9000
# Enable only after an independent HTTPS callback and real Hub verification are ready.
ANKE_SPORTS_YOUTUBE_WEBSUB_ENABLED=false
# Verified Firebase UIDs only. An empty list grants no public-link maintenance access.
ANKE_SPORTS_MAINTAINER_IDS=[]
# HEAD checks do not prove playback; enable only for approved source domains.
# Expired review records are withdrawn even while automatic network checks are disabled.
ANKE_SPORTS_BROADCAST_CHECKS_ENABLED=false
# Outside local mode, enable individual real sources only after redistribution review.
# Local source feeds are available for testing; demo data never becomes a deployed feed.
ANKE_SPORTS_PUBLIC_FEED_SOURCE_KEYS=[]
# AzureQueueConnection=<Azure Storage connection string>
