ANKE_SPORTS_ENV=local
ANKE_SPORTS_STORAGE_BACKEND=sql
ANKE_SPORTS_DATABASE_URL=sqlite:///./data/anke-sports.db
# Document adapter migration is in progress; existing HTTP/Functions entrypoints remain SQL.
# ANKE_SPORTS_STORAGE_BACKEND=documents-local
# ANKE_SPORTS_DOCUMENT_LOCAL_PATH=data/documents-local.db
# Real Cosmos: explicit selection, dedicated managed identity, no account keys or SQL fallback.
# ANKE_SPORTS_STORAGE_BACKEND=cosmos
# ANKE_SPORTS_COSMOS_ENDPOINT=https://<independent-anke-sports-account>.documents.azure.com
# ANKE_SPORTS_COSMOS_DATABASE=anke-sports
# ANKE_SPORTS_COSMOS_STATE_CONTAINER=state
# ANKE_SPORTS_COSMOS_INDEX_CONTAINER=indexes
# ANKE_SPORTS_COSMOS_AUTH=managed_identity
# ANKE_SPORTS_COSMOS_CLIENT_ID=<dedicated-user-assigned-identity-client-id>
# Local real-Cosmos access only: COSMOS_AUTH=azure_cli with both explicit tenant/subscription.
# ANKE_SPORTS_COSMOS_TENANT_ID=<development-tenant-id>
# ANKE_SPORTS_COSMOS_SUBSCRIPTION_ID=<development-subscription-id>
ANKE_SPORTS_PUBLIC_URL=http://localhost:8787
ANKE_SPORTS_WEB_URL=http://localhost:3000
ANKE_SPORTS_LOCAL_PREVIEW=true
# Independent Anke Sports Firebase project; never reuse another product's credentials.
ANKE_SPORTS_FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository.json
# Azure Key Vault reference supplies this JSON at runtime; never put its value in Git.
# ANKE_SPORTS_FIREBASE_CREDENTIALS_JSON=
# Required outside local mode: URL-safe Fernet encryption key.
ANKE_SPORTS_ENCRYPTION_KEY=
BALLDONTLIE_API_KEY=
FOOTBALL_DATA_API_KEY=
YOUTUBE_API_KEY=
# Cost-first semantic adjudication. Disabled until a dedicated key is supplied by Key Vault.
ANKE_SPORTS_MATCHING_AI_ENABLED=false
GEMINI_API_KEY=
# Fixed low-cost snapshot; thresholds are initial policy values and must be calibrated with reviewed samples.
ANKE_SPORTS_MATCHING_AI_MODEL=gemini-3.1-flash-lite
ANKE_SPORTS_MATCHING_AI_AUTO_THRESHOLD=0.90
ANKE_SPORTS_MATCHING_AI_REVIEW_THRESHOLD=0.55
# Google project that owns the key; shared across all API/worker instances.
ANKE_SPORTS_YOUTUBE_PROJECT_ID=
# Local application cap, not actual Google quota. Resets at Pacific midnight.
ANKE_SPORTS_YOUTUBE_DAILY_BUDGET=9000
# Enable only after an independent HTTPS callback and real Hub verification are ready.
ANKE_SPORTS_YOUTUBE_WEBSUB_ENABLED=false
# Verified Firebase UIDs only. An empty list grants no public-link maintenance access.
ANKE_SPORTS_MAINTAINER_IDS=[]
# HEAD checks do not prove playback; enable only for approved source domains.
# Expired review records are withdrawn even while automatic network checks are disabled.
ANKE_SPORTS_BROADCAST_CHECKS_ENABLED=false
# Outside local mode, enable individual real sources only after redistribution review.
# Local source feeds are available for testing; demo data never becomes a deployed feed.
ANKE_SPORTS_PUBLIC_FEED_SOURCE_KEYS=[]
# Document backend: explicitly choose scheduled providers in staging/production.
# Empty disables scheduled ingestion there; local successful manual sources also keep refreshing.
ANKE_SPORTS_ENABLED_SPORTS_PROVIDERS=[]
# Example after choosing source coverage: ["jolpica"]
# AzureQueueConnection=<Azure Storage connection string>
# Cloud identity connection (use instead of AzureQueueConnection):
# AzureQueueConnection__queueServiceUri=https://<independent-account>.queue.core.windows.net
# AzureQueueConnection__credential=managedidentity
# AzureQueueConnection__clientId=<dedicated-user-assigned-identity-client-id>
