            "maxItems": 500,
            "title": "Follows"
          },
          "creators": {
            "items": {
              "$ref": "#/components/schemas/CreatorFollow-Input"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Creators"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences-Input"
          },
          "event_overrides": {
            "items": {
              "$ref": "#/components/schemas/EventOverride"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Event Overrides"
          },
          "link_overrides": {
            "items": {
              "$ref": "#/components/schemas/LinkOverride"
            },
            "type": "array",
            "maxItems": 2000,
