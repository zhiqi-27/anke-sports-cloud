{
  "$defs": {
    "Follow": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "team",
          "title": "Type",
          "type": "string"
        },
        "source_key": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source_key"
      ],
      "title": "Follow",
      "type": "object"
    },
    "LinkOverride": {
      "additionalProperties": false,
      "properties": {
        "event_key": {
          "title": "Event Key",
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "title": "Url",
          "type": "string"
        },
        "state": {
          "enum": [
            "block",
            "pin"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "event_key",
        "url",
        "state"
      ],
      "title": "LinkOverride",
      "type": "object"
    },
    "ManualEventSource": {
      "additionalProperties": false,
      "description": "A personal calendar source independent from team follows.",
      "properties": {
        "event_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "ManualEventSource",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "default": "Asia/Shanghai",
          "title": "Timezone",
          "type": "string"
        },
        "locale": {
          "default": "zh-CN",
          "enum": [
            "zh-CN",
            "en"
          ],
          "title": "Locale",
          "type": "string"
        },
        "watch_region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Watch Region"
        },
        "spoiler_free": {
          "default": true,
          "title": "Spoiler Free",
          "type": "boolean"
        },
        "transparent": {
          "default": true,
          "title": "Transparent",
          "type": "boolean"
        },
        "broadcast_platforms": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20,
          "title": "Broadcast Platforms",
          "type": "object"
        }
      },
      "title": "Preferences",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "follows": {
      "items": {
        "$ref": "#/$defs/Follow"
      },
      "maxItems": 500,
      "title": "Follows",
      "type": "array"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    },
    "manual_events": {
      "items": {
        "$ref": "#/$defs/ManualEventSource"
      },
      "maxItems": 2000,
      "title": "Manual Events",
      "type": "array"
    },
    "link_overrides": {
      "items": {
        "$ref": "#/$defs/LinkOverride"
      },
      "maxItems": 2000,
      "title": "Link Overrides",
      "type": "array"
    }
  },
  "title": "Config",
  "type": "object"
}
